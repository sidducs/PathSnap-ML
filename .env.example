# ---- server ----
API_HOST=0.0.0.0
API_PORT=8000
# Laptop 2 (UI) origin(s), comma separated, e.g. http://192.168.1.23:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# ---- data ----
# Folder that CONTAINS student_test/ and evaluator_test/ (and train/). Never commit it.
DATA_ROOT=./data
# Development: student_test.  Evaluation day ONLY: evaluator_test.
TRIP_SET=student_test

# ---- models ----
ARTIFACTS_DIR=./ml/artifacts
# auto = use ml/artifacts/model.joblib if present, else nearest-road baseline | nearest | model
MATCHER=auto
# Evaluation day: true -> server refuses to start without a trained model (no silent baseline fallback)
REQUIRE_MODEL=false

# ---- behaviour ----
# Keep false: reference routes must never be sent to the UI.
EXPOSE_REFERENCE_ROUTE=false
WARMUP=true
CANDIDATE_RADIUS_M=75
MAX_CANDIDATES=8
